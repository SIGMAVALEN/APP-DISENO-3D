# Copiá como .env para desarrollo. En Render se cargan desde el panel (Environment).
PORT=3000
JWT_SECRET=cambiar-por-un-texto-largo-y-aleatorio
# Base de datos: vacío = archivo local ./data/blendgo.db. En producción, Turso:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# IA (https://aistudio.google.com/apikey). Vacío = modo local sin IA (intérprete básico)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Login con Google: IDs de cliente OAuth separados por coma (al menos el "Web")
GOOGLE_CLIENT_IDS=
# Email para recuperar contraseña (Brevo o Resend; Render free bloquea SMTP)
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=BlendGO! <tu-remitente-verificado@gmail.com>
# SOLO para demos sin email: muestra el código de recuperación en la app
DEMO_SHOW_RESET_CODE=false
# Tareas programadas disparadas desde un cron externo (header x-cron-secret)
CRON_SECRET=
# Link público del APK (se muestra en la web)
APK_URL=
