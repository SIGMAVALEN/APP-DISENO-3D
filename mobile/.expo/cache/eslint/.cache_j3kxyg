1,"endColumn":53},{"ruleId":"157","severity":2,"message":"161","line":161,"column":18,"nodeType":null,"endLine":161,"endColumn":22},{"ruleId":"157","severity":2,"message":"162","line":161,"column":18,"nodeType":null,"endLine":161,"endColumn":34},{"ruleId":"157","severity":2,"message":"163","line":40,"column":3,"nodeType":null,"endLine":40,"endColumn":21},{"ruleId":"164","severity":2,"message":"165","line":23,"column":33,"nodeType":"166","endLine":23,"endColumn":50},{"ruleId":"167","severity":2,"message":"168","line":31,"column":34,"nodeType":null,"endLine":31,"endColumn":40},{"ruleId":null,"message":"169","line":35,"column":71,"severity":1,"nodeType":null,"fix":"170"},{"ruleId":"171","severity":1,"message":"172","line":35,"column":105,"nodeType":"173","endLine":35,"endColumn":122,"suggestions":"174"},{"ruleId":"171","severity":1,"message":"175","line":37,"column":9,"nodeType":"176","endLine":37,"endColumn":38},{"ruleId":"171","severity":1,"message":"177","line":32,"column":6,"nodeType":"173","endLine":32,"endColumn":8,"suggestions":"178","suppressions":"179"},{"ruleId":"180","severity":1,"message":"181","line":58,"column":14,"nodeType":"166","messageId":"182","endLine":58,"endColumn":15},{"ruleId":"167","severity":2,"message":"183","line":48,"column":21,"nodeType":null,"endLine":48,"endColumn":27},{"ruleId":"157","severity":2,"message":"184","line":57,"column":3,"nodeType":null,"endLine":57,"endColumn":20},{"ruleId":"157","severity":2,"message":"185","line":157,"column":17,"nodeType":null,"endLine":157,"endColumn":54},{"ruleId":"157","severity":2,"message":"185","line":157,"column":17,"nodeType":null,"endLine":157,"endColumn":54},{"ruleId":"157","severity":2,"message":"185","line":157,"column":17,"nodeType":null,"endLine":157,"endColumn":54},{"ruleId":"157","severity":2,"message":"185","line":157,"column":17,"nodeType":null,"endLine":157,"endColumn":54},{"ruleId":"157","severity":2,"message":"185","line":157,"column":17,"nodeType":null,"endLine":157,"endColumn":54},{"ruleId":"157","severity":2,"message":"185","line":157,"column":17,"nodeType":null,"endLine":157,"endColumn":54},{"ruleId":"167","severity":2,"message":"186","line":184,"column":25,"nodeType":null,"endLine":184,"endColumn":38},{"ruleId":"167","severity":2,"message":"187","line":50,"column":21,"nodeType":null,"endLine":50,"endColumn":27},{"ruleId":"171","severity":1,"message":"188","line":50,"column":34,"nodeType":"173","endLine":50,"endColumn":38,"suggestions":"189","suppressions":"190"},"react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n  20 |   const pan = useMemo(\n  21 |     () =>\n> 22 |       PanResponder.create({\n     |                           ^\n> 23 |         onStartShouldSetPanResponder: () => interactivo,\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 24 |         onMoveShouldSetPanResponder: (_e, g) => interactivo && (Math.abs(g.dx) > 4 || Math.abs(g.dy) > 4),\n     …\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 33 |         },\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 34 |       }),\n     | ^^^^^^^^ Passing a ref to a function may read its value during render\n  35 |     [interactivo]\n  36 |   );\n  37 |   const camRef = useRef(cam);","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n  36 |   );\n  37 |   const camRef = useRef(cam);\n> 38 |   camRef.current = cam;\n     |   ^^^^^^^^^^^^^^ Cannot update ref during render\n  39 |\n  40 |   const escena = useMemo(() => {\n  41 |     const c = crearCamara({ ...cam, ancho: size.w, alto: size.h, orto });","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n  149 | export function ProgressBar({ value, max = 1, color, height = 10, style }) {\n  150 |   const { colors } = useTheme();\n> 151 |   const anim = useRef(new Animated.Value(0)).current;\n      |                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  152 |   const pct = Math.max(0, Math.min(1, max ? value / max : 0));\n  153 |   useEffect(() => {\n  154 |     Animated.spring(anim, { toValue: pct, useNativeDriver: false, friction: 9, tension: 40 }).start();","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n  159 |         style={{\n  160 |           height: '100%', borderRadius: height, backgroundColor: color || colors.primary,\n> 161 |           width: anim.interpolate({ inputRange: [0, 1], outputRange: ['0%', '100%'] }),\n      |                  ^^^^ Passing a ref to a function may read its value during render\n  162 |         }}\n  163 |       />\n  164 |     </View>","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n  159 |         style={{\n  160 |           height: '100%', borderRadius: height, backgroundColor: color || colors.primary,\n> 161 |           width: anim.interpolate({ inputRange: [0, 1], outputRange: ['0%', '100%'] }),\n      |                  ^^^^^^^^^^^^^^^^ Passing a ref to a function may read its value during render\n  162 |         }}\n  163 |       />\n  164 |     </View>","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n  38 |   const { setPreferencia } = useTheme();\n  39 |   const usuarioRef = useRef(null);\n> 40 |   usuarioRef.current = usuario;\n     |   ^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  41 |\n  42 |   const aplicarUsuario = useCallback((u) => {\n  43 |     setUsuario(u);","import/namespace","'AndroidImportance' not found in imported namespace 'Notifications'.","Identifier","react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  29 |\n  30 |   useFocusEffect(useCallback(() => { if (enFoco) cargar('foco'); }, [cargar, enFoco]));\n> 31 |   useEffect(() => { if (!enFoco) cargar(); }, [cargar, enFoco]);\n     |                                  ^^^^^^ Avoid calling setState() directly within an effect\n  32 |\n  33 |   return { data, error, cargando: cargando && !data, refrescando, recargar: () => cargar('refresh'), setData };\n  34 | }","Unused eslint-disable directive (no problems were reported).",{"range":"191","text":"192"},"react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'refrescar'. Either include it or remove the dependency array.","ArrayExpression",["193"],"The 'lista' logical expression could make the dependencies of useMemo Hook (at line 45) change on every render. To fix this, wrap the initialization of 'lista' in its own useMemo() Hook.","VariableDeclarator","React Hook useEffect has missing dependencies: 'ejercicios' and 'refrescar'. Either include them or remove the dependency array.",["194"],["195"],"no-unused-vars","'e' is defined but never used. Allowed unused caught errors must match /^_/u.","unusedVar","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  46 |     }\n  47 |   }, [id]);\n> 48 |   useEffect(() => { cargar(); }, [cargar]);\n     |                     ^^^^^^ Avoid calling setState() directly within an effect\n  49 |\n  50 |   useLayoutEffect(() => {\n  51 |     if (!enModoLibre) navigation.setOptions({ title: ejercicio?.titulo || 'Simulador' });","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n  55 |\n  56 |   const estadoRef = useRef(estado);\n> 57 |   estadoRef.current = estado;\n     |   ^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  58 |\n  59 |   /** Anima suavemente el objeto hacia un nuevo estado (para las órdenes de la IA). */\n  60 |   const animarHacia = useCallback((destino) => {","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n  155 | function BotonIA({ onPress, bottom }) {\n  156 |   const { colors } = useTheme();\n> 157 |   const pulso = useRef(new Animated.Value(1)).current;\n      |                 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  158 |   useEffect(() => {\n  159 |     const loop = Animated.loop(Animated.sequence([\n  160 |       Animated.timing(pulso, { toValue: 1.07, duration: 900, useNativeDriver: true }),","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  182 |   const [xpMostrada, setXpMostrada] = useState(0);\n  183 |   useEffect(() => {\n> 184 |     if (!r?.xpGanada) { setXpMostrada(0); return undefined; }\n      |                         ^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  185 |     let n = 0;\n  186 |     const t = setInterval(() => { n += Math.ceil(r.xpGanada / 20); setXpMostrada(Math.min(n, r.xpGanada)); if (n >= r.xpGanada) clearInterval(t); }, 30);\n  187 |     return () => clearInterval(t);","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  48 |   };\n  49 |   // eslint-disable-next-line react-hooks/exhaustive-deps\n> 50 |   useEffect(() => { cargar(); }, [id]);\n     |                     ^^^^^^ Avoid calling setState() directly within an effect\n  51 |\n  52 |   const set = (k) => (v) => { setForm((f) => ({ ...f, [k]: v })); setErrores((e) => ({ ...e, [k]: null })); };\n  53 |","React Hook useEffect has a missing dependency: 'cargar'. Either include it or remove the dependency array.",["196"],["197"],[1505,1535]," ",{"desc":"198","fix":"199"},{"desc":"200","fix":"201"},{"kind":"202","justification":"203"},{"desc":"204","fix":"205"},{"kind":"202","justification":"203"},"Update the dependencies array to be: [ejercicios.data, refrescar]",{"range":"206","text":"207"},"Update the dependencies array to be: [ejercicios, refrescar]",{"range":"208","text":"209"},"directive","","Update the dependencies array to be: [cargar, id]",{"range":"210","text":"211"},[1539,1556],"[ejercicios.data, refrescar]",[1360,1362],"[ejercicios, refrescar]",[2281,2285],"[cargar, id]"]